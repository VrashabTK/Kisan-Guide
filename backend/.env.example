PROJECT_NAME="KISSAN GUIDE"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Firebase Configuration
# Path to service account json file, or JSON string
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# Weather API Configuration (Optional: Open-Meteo is used by default with zero key required)
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1"

# AI Provider Configuration (Google Gemini or OpenAI compatible)
AI_PROVIDER="gemini"
AI_API_KEY=
AI_MODEL="gemini-1.5-flash"

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL="support@kissanguide.local"
